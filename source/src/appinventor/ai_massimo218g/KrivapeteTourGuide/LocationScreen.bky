<xml xmlns="http://www.w3.org/1999/xhtml"><block type="global_declaration" id="ZN|Ljgd!.L?ju/N)b+Fc" x="-782" y="-747"><field name="NAME">LocationIndex</field><value name="VALUE"><block type="math_number" id=",CVgf{,Qu@%nJW8dOo5_"><field name="NUM">0</field></block></value></block><block type="global_declaration" id="ysHu]:`zrh)c*2oJkUcL" x="-790" y="-696"><field name="NAME">Locations</field><value name="VALUE"><block type="lists_create_with" id="~mgihImG;*OZ7(dFP]--"><mutation items="6"></mutation><value name="ADD0"><block type="text" id="0|V);B)ovx86GUwM#~st"><field name="TEXT">Sarženska</field></block></value><value name="ADD1"><block type="text" id="w2^Vpd[[?p@604=9w(+q"><field name="TEXT">Ivanka</field></block></value><value name="ADD2"><block type="text" id="t1*T6y|)-SX4}(HPpS?+"><field name="TEXT">Matajurka</field></block></value><value name="ADD3"><block type="text" id=".)xT_k$|@{.}3q7UD18R"><field name="TEXT">Arbeška</field></block></value><value name="ADD4"><block type="text" id="n5pHx56kOtrXU=td0`3j"><field name="TEXT">Rečanka</field></block></value><value name="ADD5"><block type="text" id="~sb@cKpX:Bj8E_)G93@#"><field name="TEXT">Starogorka</field></block></value></block></value></block><block type="component_event" id="2!:4mpk6NK3w8ESESx}e" x="92" y="-664"><mutation component_type="Form" is_generic="false" instance_name="LocationScreen" event_name="Initialize"></mutation><field name="COMPONENT_SELECTOR">LocationScreen</field><statement name="DO"><block type="lexical_variable_set" id="__aCR/{A(X(2/M2G(X/h"><field name="VAR">global LocationIndex</field><value name="VALUE"><block type="lists_position_in" id="8UStZzh!7u[=H3`](J*Z"><value name="ITEM"><block type="controls_getStartValue" id="ZraQm{4Q0r(^Ljp:_Q:7"></block></value><value name="LIST"><block type="lexical_variable_get" id="IxmH(d|w{ZJBb*o_TSz8"><field name="VAR">global Locations</field></block></value></block></value><next><block type="component_set_get" id="7=Ao;z$:q+ftLkXK|-}H"><mutation component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="LocationLabel"></mutation><field name="COMPONENT_SELECTOR">LocationLabel</field><field name="PROP">Text</field><value name="VALUE"><block type="lists_select_item" id="Y9NjeZ4K6u]nLTi7W!(x"><value name="LIST"><block type="lexical_variable_get" id="A:Z(~0N;BE9|cM]R^f|i"><field name="VAR">global Locations</field></block></value><value name="NUM"><block type="lexical_variable_get" id="_FpdZ=npv@+vB7tgz#I;"><field name="VAR">global LocationIndex</field></block></value></block></value><next><block type="component_set_get" id="v$6b9Z;cWn-:D80ix/}u"><mutation component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="DescriptionLabel"></mutation><field name="COMPONENT_SELECTOR">DescriptionLabel</field><field name="PROP">Text</field><value name="VALUE"><block type="lists_select_item" id="jaj2B/EJ?k7X)k36jK_D"><value name="LIST"><block type="lexical_variable_get" id="V.){b$:5292Nv7DG5^vo"><field name="VAR">global Descriptions</field></block></value><value name="NUM"><block type="lexical_variable_get" id="]Ee4qs!So[f[aB-c^3|e"><field name="VAR">global LocationIndex</field></block></value></block></value><next><block type="component_set_get" id="Vg;:Zi#k%mX5n|s@3EUQ"><mutation component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Image1"></mutation><field name="COMPONENT_SELECTOR">Image1</field><field name="PROP">Picture</field><value name="VALUE"><block type="lists_select_item" id="D1,;23tBOcpNQ)cl~8HO"><value name="LIST"><block type="lexical_variable_get" id="F;.GzQ,b].tTDfqcg3cK"><field name="VAR">global Pictures</field></block></value><value name="NUM"><block type="lexical_variable_get" id="ZymRbLsvzAyavel){dES"><field name="VAR">global LocationIndex</field></block></value></block></value></block></next></block></next></block></next></block></statement></block><block type="global_declaration" id="Mx9(FJ;aIdk%b6TJ$$vC" x="-796" y="-522"><field name="NAME">Descriptions</field><value name="VALUE"><block type="lists_create_with" id="$7Wbt,C(]}v0`uIh{4#="><mutation items="6"></mutation><value name="ADD0"><block type="text" id="iLpFK^ts6My/RJ2PPY9c"><field name="TEXT">Chi non mi conosce,  Su dietro a Makota, a Tarnje sotto le rocce vivevamo…dove sono ormai i tempi in cui quel giovane mi ha condotto in paese, dove ho insegnato, tutto, tutto quello che sapevo…anche a fare la gubana e gli strucchi!</field></block></value><value name="ADD1"><block type="text" id="||1lQ^RE88x7`vsM$T[o"><field name="TEXT">Takuo me kličejo zaki te pravo  ime Landarja  je svet Ivan gu čele. Pravejo de san  usadila tist star kostanj gu host blizu Ofjane,  dan te narbuj starih Nediških dolin… resnice na bota nikdar viedel pa ga šele varjen zaki jih je puno provu.  Mi chiamano così perché Antro si chiama San Giovanni d’Antro… Giovanni per noi è Ivan. Dicono che sia stata io a piantare il castagno centenario nel bosco nei pressi di Pegliano, uno dei più vecchi delle Valli del Natisone… La verità non la saprete mai anche se è vero che io me ne prendo cura perché ne ha passate tante.</field></block></value><value name="ADD2"><block type="text" id="f=AdS0kwS$MC{C*7Nurh"><field name="TEXT"> …san, živim gor na Velik Bab, ku ki so pravli naši te stari.  Iman tri škrate tle okuole,  ki dušpetujejo tud ljuden,  ki hodejo na naš Triglav an se ustavejo v koči Dom na Matajure.  Vivo qui sulla Velika Baba, la grande Madre come la chiamavano i vecchi abitanti. Ho tre škrat che mi girano intorno e fanno dispetti anche alle persone che vengono a camminare sul nostro Triglav e si fermano nel rifugio Doma na Matajure.</field></block></value><value name="ADD3"><block type="text" id="m8y:I#*+`MyQf!.Qk*^R"><field name="TEXT"> An tle na manjkajo ljudje, ki hodejo gledat slap Kot. Kajšan krat mi se zdi de ljudje na zastopejo kakuo so bli navezani na njih korenine, kakuo so saldu gledal prenest na mlade roduove njih bogatijo…  Anche qui non manca la gente che viene a vedere le cascate di Coot. Alle volte ho l’impressione che non capiscano quanto i nostri antenati fossero legati alle proprie radici, come hanno sempre cercato di tramandare questa ricchezza alle nuove generazioni</field></block></value><value name="ADD4"><block type="text" id="v8=Ld0ou36,D/q^~WP!5"><field name="TEXT">San šele tle v Rečanski dolin…  dobro čujen an dobro viden…samuo, ki tisti gu Tapoluoven me vsako  zmiešajo… puošta, letališče za aeroplane, ambašade… se zmišnjavajo vsega  Abito ancora qui nella valle dell’Erbezzo, vedo e sento ancora bene… solo che quelli a Topolò mi confondono…la posta, l’aeroporto, le ambasciate…veramente le inventano di tutti i colori</field></block></value><value name="ADD5"><block type="text" id="LNhYl;az{(h+/=N;q9L`"><field name="TEXT">Nu,  ki takuo niesmo same, videmo še kakega človieka…tle jih hode puno…čujen vsake sort jezike. Eh ja, zluodja san vidla, ma ki je ùe tist cajt ….  Su che così non siamo sole, vediamo almeno un po’ di gente…qui veramente ne viene tanta… sento parlare veramente molte lingue.  Si, certo ho visto il diavolo, ma è un ricordo lontano nel tempo…</field></block></value></block></value></block><block type="component_event" id="NW`GY~N~m}k-[DDKpg59" x="87" y="-387"><mutation component_type="Button" is_generic="false" instance_name="BListen" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">BListen</field><statement name="DO"><block type="component_method" id="gyhUJ@tKR.Nd/@R5OIsw"><mutation component_type="TextToSpeech" method_name="Speak" is_generic="false" instance_name="TextToSpeech1"></mutation><field name="COMPONENT_SELECTOR">TextToSpeech1</field><value name="ARG0"><block type="component_set_get" id="_F2nqv.#ZQ{J.#z1B97t"><mutation component_type="Label" set_or_get="get" property_name="Text" is_generic="false" instance_name="DescriptionLabel"></mutation><field name="COMPONENT_SELECTOR">DescriptionLabel</field><field name="PROP">Text</field></block></value></block></statement></block><block type="global_declaration" id="DQla2*^0@|a-WE6j|3^7" x="-800" y="-339"><field name="NAME">Pictures</field><value name="VALUE"><block type="lists_create_with" id="LrqiZN?mvr78Wvhb{/!r"><mutation items="6"></mutation><value name="ADD0"><block type="text" id="MzsfDPG]k=Fnf`y?tr8,"><field name="TEXT">Sarzenska.jpg</field></block></value><value name="ADD1"><block type="text" id="~x?I?X6Lj0r2{~TnE6rO"><field name="TEXT">Ivanka.jpg</field></block></value><value name="ADD2"><block type="text" id="Q|u%bgbKto]L]i~6E]F%"><field name="TEXT">Matajurka.jpg</field></block></value><value name="ADD3"><block type="text" id="HNMZx]H}#.rXheE1TCbZ"><field name="TEXT">Arbeska.jpg</field></block></value><value name="ADD4"><block type="text" id="p=6QpO[20}|T0V2|v7}r"><field name="TEXT">Recanka.jpg</field></block></value><value name="ADD5"><block type="text" id="XM##2mM^?k**zfpPD.g="><field name="TEXT">Starogorka.jpg</field></block></value></block></value></block><block type="component_event" id="@!Ojx]hIte(vJr0L9YVr" x="87" y="-264"><mutation component_type="Button" is_generic="false" instance_name="BGallery" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">BGallery</field><statement name="DO"><block type="controls_openAnotherScreenWithStartValue" id="xbE`GjVc0htRJ49t!cN$"><value name="SCREENNAME"><block type="helpers_screen_names" id="Q?2^tA8X~.oPc34fqJpU"><field name="SCREEN">GalleryScreen</field></block></value><value name="STARTVALUE"><block type="controls_getStartValue" id="GoqP^:)4z?ahUsac74:!"></block></value></block></statement></block><block type="global_declaration" id="Vq*!;[StF5Vqn6]gC)]:" x="-768" y="-76"><field name="NAME">CurrentLocation</field><value name="VALUE"><block type="lists_create_with" id="tcIb$^}5Ph(|imAS2G!g"><mutation items="0"></mutation></block></value></block><block type="global_declaration" id="`S7wY!rGLIa)tl2O+Wm!" x="-773" y="-32"><field name="NAME">DestinationAddress</field><value name="VALUE"><bl